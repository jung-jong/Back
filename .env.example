DATABASE_URL=mysql+aiomysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:4000/<DB_NAME>
DATABASE_SSL=true
DATABASE_ECHO=false

APP_NAME=Custom-TA API
APP_ENV=local
APP_DEBUG=true
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://172.20.10.7:5173,https://custom-ta.vercel.app

UPLOAD_DIR=static/uploads
STORAGE_PROVIDER=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=
S3_PREFIX=uploads
S3_PRESIGNED_URL_EXPIRES=3600

JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

AI_PROVIDER=gemini
AI_MAX_OUTPUT_TOKENS=1024

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_OUTPUT_DIMENSIONALITY=768

EMBEDDING_PROVIDER=gemini
LOCAL_RAG_ENABLED=true
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5

WEEKLY_INTERVENTION_SCHEDULER_ENABLED=false
WEEKLY_INTERVENTION_INTERVAL_SECONDS=3600
WEEKLY_INTERVENTION_RUN_ON_STARTUP=false
